{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROMAS",
  "version": "2.0.0",
  "identifier": "com.qmaintenance.promas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Promas(P) Version 2.0 — Property Management System",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": [0, 0, 170]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
